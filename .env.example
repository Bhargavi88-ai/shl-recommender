# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Required: Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Set to "true" to re-scrape the SHL catalog on startup
# Leave as "false" to use the bundled catalog.json
FORCE_SCRAPE=false

# Optional: Port for the FastAPI server (default: 8000)
PORT=8000
